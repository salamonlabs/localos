#!/bin/sh
# Eseguito dentro il sistema in costruzione, alla fine della fase chroot.
set -e

# Servizi di sistema
systemctl enable nftables.service
systemctl enable NetworkManager.service
systemctl enable systemd-resolved.service

# La shell web locale ora parte dalla sessione grafica (localos-session), non più come servizio:
# così può aprire le finestre del browser.
systemctl --global disable localos-shell.service 2>/dev/null || true
rm -f /etc/systemd/user/localos-shell.service

# Syncthing NON parte da solo: lo avvia l'app Sincronizza quando la apri
# (così chi non lo usa non fa nessuna connessione verso i suoi server).
systemctl --global disable syncthing.service 2>/dev/null || true

chmod 0755 /usr/local/bin/localos-session /usr/lib/localos/localos-shell.py /usr/lib/localos/localos-persistence
chmod 0440 /etc/sudoers.d/localos

# Memoria cifrata: cryptsetup sempre incluso nell'initramfs, anche senza /etc/crypttab
# Tema grafico local:os (avvio, richiesta della frase segreta, spegnimento)
plymouth-set-default-theme localos || echo "AVVISO local:os: tema Plymouth non impostato"

echo "CRYPTSETUP=y" >> /etc/cryptsetup-initramfs/conf-hook
update-initramfs -u -k all || echo "AVVISO local:os: update-initramfs non riuscito, la memoria cifrata potrebbe non aprirsi all'avvio"

# Le policy del browser vanno in tutti i percorsi che Firefox ESR può leggere
mkdir -p /etc/firefox-esr/policies /usr/lib/firefox-esr/distribution
ln -sf /etc/firefox/policies/policies.json /etc/firefox-esr/policies/policies.json
ln -sf /etc/firefox/policies/policies.json /usr/lib/firefox-esr/distribution/policies.json

# Ora: solo i server NTS di local:os (disattiva il pool predefinito e i server suggeriti dal router)
sed -i -e 's/^pool /#pool /' -e 's|^sourcedir /run/chrony-dhcp|#sourcedir /run/chrony-dhcp|' /etc/chrony/chrony.conf
systemctl enable chrony.service

# Versione
echo "0.3.2" > /etc/localos-release

# Lingua italiana di default
sed -i 's/^# *it_IT.UTF-8/it_IT.UTF-8/' /etc/locale.gen
locale-gen

# Alleggerimento: via manuali, documentazione e cache apt.
# I file di licenza (/usr/share/doc/*/copyright) restano: servono per ridistribuire.
find /usr/share/doc -type f ! -name copyright -delete
rm -rf /usr/share/man/* /var/cache/apt/archives/*.deb
